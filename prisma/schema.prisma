// SimplyLive data model
// Architectural keystone: Entry is a single table with a `kind` discriminator
// and a JSONB `data` payload. Goals and Habits get dedicated tables because
// they're referenced by other entries; Journals/Todos/Blocks/Notes live inside
// Entry only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())

  entries         Entry[]
  goals           Goal[]
  habits          Habit[]
  habitCategories HabitCategory[]
}

enum EntryKind {
  JOURNAL
  TODO
  HABIT
  BLOCK
  GOAL_NOTE
  ACTIVITY
  FOOD
}

model Entry {
  id        String    @id @default(cuid())
  userId    String
  kind      EntryKind
  data      Json
  tags      String[]  @default([])
  goalRefs  String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([userId, createdAt])
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum HabitCadence {
  DAILY
  WEEKLY
  CUSTOM
  EVERY_N_DAYS
}

model Habit {
  id           String       @id @default(cuid())
  userId       String
  title        String
  cadence      HabitCadence @default(DAILY)
  // For CUSTOM cadence: array of weekday numbers 0-6 (Sun-Sat)
  weekdays     Int[]        @default([])
  // For EVERY_N_DAYS cadence: do the habit every N days (relative to last completion)
  intervalDays Int?
  archived     Boolean      @default(false)
  categoryId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category HabitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, archived])
  @@index([userId, categoryId])
}

model HabitCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@unique([userId, name])
  @@index([userId])
}
