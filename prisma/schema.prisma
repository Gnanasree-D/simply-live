// SimplyLive — minimal server schema for E2EE sync.
// The server stores ONLY:
//   - identity (email + password hash for auth)
//   - salts (for the client's password-based key derivation)
//   - opaque encrypted blob (server cannot decrypt this)
// All actual app data — entries, goals, habits, milestones, etc. —
// lives in the client's IndexedDB and inside the encrypted blob below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  kdfSalt        String   // base64 salt used by the client's PBKDF2
  recoveryHash   String?  // bcrypt of the one-time recovery key
  recoverySalt   String?  // separate base64 salt for the recovery-key KDF
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  syncState SyncState?
}

model SyncState {
  userId        String   @id
  version       Int      @default(0)
  encryptedBlob String   // base64-encoded {iv, ciphertext} — opaque to server
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
